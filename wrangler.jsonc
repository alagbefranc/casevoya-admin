// casevoya-admin on Cloudflare Workers, built with OpenNext. Served only at admin.casevoya.ca,
// which is behind the Cloudflare Access application "Casevoya admin" (admin@casevoya.ca only,
// independent MFA required). No workers.dev or preview URLs, so Access is the only way in, and the
// app re-verifies the Access JWT itself on every page and server action.
//
// Secrets (set by scripts/set-worker-secret.sh, never in this file): SUPABASE_SECRET_KEY,
// SUPABASE_PUBLISHABLE_KEY (used only to sign the template reviewer in with their own session).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casevoya-admin",
  "main": ".open-next/worker.js",
  "account_id": "c8010438fc56280e3ea5747a123e818a",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.casevoya.ca", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // OpenNext self-reference; the service name must match the Worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "casevoya-admin" }
  ],
  // Per-caller throttles for /api/admin/* (src/lib/rate-limit.ts), keyed on the verified Access subject (Setup:
  // the Access email). Limits are per 60 seconds; namespace ids are unique to this account.
  "ratelimits": [
    { "name": "ADMIN_API_READ", "namespace_id": "2101", "simple": { "limit": 120, "period": 60 } },
    { "name": "ADMIN_API_WRITE", "namespace_id": "2102", "simple": { "limit": 20, "period": 60 } },
    // Support-access request creation and real (non-dry-run) CICC imports.
    { "name": "ADMIN_SENSITIVE", "namespace_id": "2103", "simple": { "limit": 5, "period": 60 } },
    { "name": "ADMIN_SETUP", "namespace_id": "2104", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "SUPABASE_URL": "https://aqjtvqmojfamtspzyeqm.supabase.co",
    "CF_ACCESS_TEAM_DOMAIN": "orange-resonance-3cfd.cloudflareaccess.com",
    // Audience tag of the Access application (public; it is inside every Access JWT).
    "CF_ACCESS_AUD": "a3f3f4c08ee4828a820661fbd1955ed9994243b6e6ec848864f1a53475207825",
    // The static base of the allow list (never removed from the Access policy). Invited admins are NOT added
    // here: the portal admits any email with an open invite or a platform_admins row, and adds/removes it on
    // the Access policy itself (src/lib/access-policy.ts). Template reviewers are a platform_admins flag.
    "ADMIN_ALLOWED_EMAILS": "admin@casevoya.ca",
    // Admin invites: the Access app and its email-only allow policy the portal keeps in step, and the invite
    // email sender (Cloudflare Email Sending). The token is the secret CF_ADMIN_TOKEN (Access: Apps and
    // Policies Write + Email Sending Write, this account only).
    "CF_ACCOUNT_ID": "c8010438fc56280e3ea5747a123e818a",
    "CF_ACCESS_APP_ID": "76c4d190-fcd6-498d-a63e-5e9b8a968dab",
    "CF_ACCESS_POLICY_ID": "27c25915-8305-45a6-b642-f10a8a768baf",
    "ADMIN_MAIL_FROM": "notices@casevoya.ca",
    // Mutating /api/admin/* calls must carry this Origin (CSRF check).
    "ADMIN_ORIGIN": "https://admin.casevoya.ca"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  }
}
